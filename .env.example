# ===================================================================
# LUCID: THE LIVING DREAM — Environment Configuration
# ===================================================================

# Web Frontend Environment Variables (Vite prefix: VITE_)
# Backend API base URL (leave empty in production for relative origin or offline local demo mode)
VITE_API_URL=http://localhost:4000

# Realtime WebSocket / Socket.IO Gateway URL (defaults to VITE_API_URL)
VITE_SOCKET_URL=http://localhost:4000

# Backend API Service Configuration
PORT=4000
NODE_ENV=production

# Allowed CORS origins for API (comma-separated or '*' for public access)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,https://lucid-universe.vercel.app

# Optional Database Persistence (leave blank for authoritative in-memory mode)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lucid_multiverse?retryWrites=true&w=majority
